# Первый владелец создаётся только в пустой базе.
# Задайте свой пароль длиной 16–256 символов перед первым запуском.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Адрес, по которому вы будете открывать приложение.
PORT=3210
PUBLIC_ORIGIN=http://127.0.0.1:3210

# Compose задаёт пути базы/данных, Node и браузера внутри контейнера.
# Для HTTPS-сайта за доверенным reverse proxy см. docs/docker.md.
# TRUST_PROXY=loopback

# Дополнительные настройки ACP и диктовки: docs/docker.md.
# Это пути внутри контейнера; отдельные mounts задаются в compose.private.yaml.
# ACP_COMMAND=/absolute/path/to/codex-acp
# ACP_ARGS_JSON=[]
# CODEX_HOME=/absolute/private/path/to/codex-auth

# Необязательный резерв диктовки: whisper.cpp и многоязычная GGML-модель.
# WHISPER_COMMAND=/absolute/path/to/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-base.bin
# LIBREOFFICE_COMMAND=/usr/bin/libreoffice
# DOCUMENT_SANDBOX_COMMAND=/usr/bin/bwrap
